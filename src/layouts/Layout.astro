---
interface Props {
  title?: string;
  description?: string;
  activeNav?: 'inicio' | 'proyectos' | 'podcast' | 'blog' | 'contacto';
  wide?: boolean;
  showFooter?: boolean;
}

const {
  title = 'Amauris Willmore - Developer & Product Designer',
  description = 'Amauris Willmore, diseñador de producto UI/UX y software enthusiast.',
  activeNav,
  wide = false,
  showFooter = true,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" href={`${base}/favicon-aw.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      />
    </noscript>
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
    <style is:global>
      :root {
        color-scheme: light;
        /* Proporción Áurea (Golden Ratio: 1.6180339887) */
        --phi: 1.6180339887;
        /* Velocidades de carga y animación divididas entre 1.618 */
        --t-reveal: calc(400ms / var(--phi));       /* 247.2ms */
        --t-stagger: calc(100ms / var(--phi));      /* 61.8ms */
        --t-theme: calc(180ms / var(--phi));        /* 111.2ms */
        --t-fast: calc(120ms / var(--phi));         /* 74.2ms */
        --ease-phi: cubic-bezier(0.25, 0.1, 0.25, 1);

        --page: #fafafa;
        --surface: #ffffff;
        --surface-hover: #f3f3f2;
        --ink: #202020;
        --body-ink: #484848;
        --muted: #747474;
        --rule: #d8d8d8;
        --accent: #f3e34f;
        --accent-glow: rgba(243, 227, 79, 0.25);
        --success: #22863a;
        --warning: #b08800;
        --info: #005cc5;
        font-family: 'DM Sans', sans-serif;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      :root[data-theme='dark'] {
        color-scheme: dark;
        --page: #191a18;
        --surface: #222320;
        --surface-hover: #2c2d29;
        --ink: #f1f0e8;
        --body-ink: #c5c4bd;
        --muted: #a09f97;
        --rule: #43443f;
        --accent: #e9d943;
        --accent-glow: rgba(233, 217, 67, 0.2);
        --success: #34d058;
        --warning: #f9c513;
        --info: #58a6ff;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--page);
        color: var(--body-ink);
        transition: background-color var(--t-theme) var(--ease-phi), color var(--t-theme) var(--ease-phi);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      a { color: inherit; text-decoration: none; }
      a:hover { color: var(--ink); }

      .shell {
        width: min(100% - 48px, 720px);
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        flex: 1;
      }
      .shell.wide {
        width: min(100% - 48px, 1160px);
      }

      .site-header {
        min-height: 112px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        animation: phi-fade-in var(--t-reveal) var(--ease-phi) both;
      }
      .wordmark {
        color: var(--ink);
        font-size: 17px;
        font-weight: 700;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .wordmark span {
        background: var(--accent);
        color: #191a18;
        padding: 0 3px;
        border-radius: 2px;
        font-weight: 500;
      }
      .header-tools, .primary-nav {
        display: flex;
        align-items: center;
      }
      .header-tools { gap: 24px; }
      .primary-nav { gap: 20px; font-size: 15px; }
      .primary-nav a {
        transition: color var(--t-fast) var(--ease-phi);
      }
      .primary-nav a.active {
        color: var(--ink);
        font-weight: 600;
        border-bottom: 2px solid var(--accent);
        padding-bottom: 2px;
      }
      .primary-nav .nav-badge {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        background: var(--rule);
        color: var(--ink);
        padding: 2px 6px;
        border-radius: 999px;
        margin-left: -12px;
      }
      .theme-toggle {
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        padding: 0;
        color: var(--body-ink);
        background: transparent;
        border: 1px solid transparent;
        border-radius: 6px;
        cursor: pointer;
        transition: all var(--t-fast) var(--ease-phi);
      }
      .theme-toggle:hover {
        color: var(--ink);
        border-color: var(--rule);
      }
      .theme-toggle svg { width: 18px; height: 18px; }

      @keyframes phi-fade-in {
        0% {
          opacity: 0;
          transform: translateY(8px);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      main {
        flex: 1;
        padding-top: 20px;
        padding-bottom: 60px;
        animation: phi-fade-in var(--t-reveal) var(--ease-phi) var(--t-stagger) both;
        will-change: opacity, transform;
      }

      .site-footer {
        display: flex;
        justify-content: center;
        gap: 19px;
        padding: 24px 0 44px;
        color: var(--muted);
        font-size: 14px;
        border-top: 1px solid var(--rule);
        margin-top: auto;
        animation: phi-fade-in var(--t-reveal) var(--ease-phi) calc(var(--t-stagger) * 2) both;
      }
      .site-footer a:hover { color: var(--ink); }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      @media (max-width: 680px) {
        .shell, .shell.wide { width: min(100% - 36px, 100%); }
        .site-header {
          min-height: 0;
          align-items: flex-start;
          flex-direction: column;
          gap: 16px;
          padding-top: 24px;
          padding-bottom: 12px;
        }
        .header-tools { width: 100%; justify-content: space-between; gap: 12px; }
        .primary-nav { gap: clamp(10px, 4vw, 18px); font-size: 14px; flex-wrap: wrap; }
        main { padding-top: 24px; }
        .site-footer { flex-wrap: wrap; gap: 10px 16px; padding-bottom: 30px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .site-header, main, .site-footer {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
        }
        body {
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div class:list={['shell', { wide }]}>
      <header class="site-header">
        <a class="wordmark" href={`${base}/`} aria-label="Amauris Willmore, inicio">
          amauriswill<span>more</span>
        </a>
        <div class="header-tools">
          <nav class="primary-nav" aria-label="Navegación principal">
            <a href={`${base}/proyectos/`} class:list={[{ active: activeNav === 'proyectos' }]}>proyectos</a>
            <a href={`${base}/podcast/`} class:list={[{ active: activeNav === 'podcast' }]}>podcast</a>
            <a href={`${base}/blog/`} class:list={[{ active: activeNav === 'blog' }]}>blog</a>
            <a href={`${base}/contacto/`} class:list={[{ active: activeNav === 'contacto' }]}>contacto</a>
          </nav>
          <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Cambiar tema de color" title="Alternar tema claro/oscuro">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 18h6M10 21h4M8.5 14.5a7 7 0 1 1 7 0c-.9.7-1.5 1.4-1.5 2.5h-4c0-1.1-.6-1.8-1.5-2.5Z" />
            </svg>
          </button>
        </div>
      </header>

      <main>
        <slot />
      </main>

      {showFooter && (
        <footer class="site-footer" aria-label="Enlaces del pie">
          <a href="mailto:amauriswillwork@gmail.com">email</a>
          <a href="https://github.com/amauriswill" target="_blank" rel="noreferrer">github</a>
          <a href="https://www.linkedin.com/in/amauriswill/" target="_blank" rel="noreferrer">linkedin</a>
          <a href="https://behance.net/amauriswill" target="_blank" rel="noreferrer">behance</a>
          <a href="https://youtube.com/@amaurisfolio" target="_blank" rel="noreferrer">youtube</a>
          <a href={`${base}/uses/`}>uses</a>
        </footer>
      )}
    </div>

    <script>
      const toggle = document.querySelector('.theme-toggle');
      if (toggle) {
        toggle.setAttribute('aria-checked', String(document.documentElement.dataset.theme === 'dark'));
        toggle.addEventListener('click', () => {
          const isDark = document.documentElement.dataset.theme !== 'dark';
          document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
          toggle.setAttribute('aria-checked', String(isDark));
          try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
        });
      }
    </script>
  </body>
</html>
